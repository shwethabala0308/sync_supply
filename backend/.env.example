# --- App ---
ENV=development
DEBUG=true

# --- Database (SQLite works with zero setup; swap for Postgres in production) ---
# Free-tier Postgres options: Supabase, Railway, Render, Neon.
DATABASE_URL=sqlite:///./syncsupply.db
# DATABASE_URL=postgresql://user:password@host:5432/syncsupply

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
TRIAL_PERIOD_DAYS=7

# --- CORS (comma-separated origins allowed to call this API) ---
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# --- Google Maps / Places (used by the nearby-care module) ---
GOOGLE_MAPS_API_KEY=
PLACES_CACHE_SECONDS=300

SUPPORTED_LANGUAGES=en,hi,ta,kn,ml,te,mr
MIN_MATCH_SCORE=3
MAX_SYMPTOM_TEXT_LENGTH=500
EMERGENCY_NUMBER_INDIA=112

# --- OTP auth (email/phone) ---
# "console" logs the code to server logs — fine for LOCAL DEV/DEMO ONLY.
# Startup refuses to boot with OTP_PROVIDER=console when ENV=production, so
# a real provider is required before going live. "resend" is the easiest
# genuinely-free option (https://resend.com, 3,000 emails/mo, no card) — set
# OTP_PROVIDER=resend and RESEND_API_KEY. "smtp" and "twilio" remain for
# your own email/SMS provider.
OTP_PROVIDER=console
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_COOLDOWN_SECONDS=60
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@syncsupply.app
RESEND_API_KEY=
RESEND_FROM=SyncSupply <onboarding@resend.dev>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Abuse mitigation ---
TRIAL_STARTS_PER_IP_PER_DAY=5
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_SYMPTOMS=20/minute
RATE_LIMIT_PLACES=15/minute
# Shared rate-limit counters across instances/workers (free option: a free
# Upstash Redis database, https://upstash.com). Leave blank for a single
# free-tier instance/worker — counters fall back to per-process memory.
REDIS_URL=
# How many X-Forwarded-For hops to trust as added by a real proxy in front
# of this app (Render = 1). Set to 0 if running with no proxy in front.
TRUSTED_PROXY_HOPS=1

# --- Server-managed trial cookie ---
# COOKIE_SECURE must be true in production (HTTPS) for the trial cookie to
# work at all with SameSite=None across your frontend/backend domains. Set
# to false ONLY for local http://localhost development.
TRIAL_COOKIE_NAME=ss_trial
TRIAL_COOKIE_MAX_AGE_DAYS=365
COOKIE_SECURE=false
